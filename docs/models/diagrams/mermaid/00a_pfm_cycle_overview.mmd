flowchart TB
  %% QUESTION THIS DIAGRAM ANSWERS: which functions form public financial management (PFM) in the Philippines, in what order do they happen for one fiscal year, and which chapter of this atlas describes each one?
  %% READING: one framed row = one function. The text after the row title names the lead authorities. Arrows between rows = the main order for one fiscal year. Three side blocks are active during the whole year.
  %% THE CYCLE IS NOT A SIMPLE LOOP: results return to the plans and budgets of LATER fiscal years, so the last node is drawn as an exit and not as an arrow back to row 1.
  %% SOURCES: DBM primer on the budget process [PRIMER], FY 2027 Budget Call [NBM156], FY 2026 release guidelines [NBC599], procurement law [RA12009], reporting circular [JC2019-1], PFM Reforms Roadmap 2024-2028 [ROADMAP2024]. The split into nine rows is my own arrangement of those sources.
  %% LIMIT: local governments and government corporations have their own complete cycles (chapters 14 and 15). Here they appear only where national money passes to them.

  subgraph F1["1  PLAN  -  chapter 01  -  DEPDev, Economy and Development Council, ICC, Regional Development Councils"]
    direction LR
    F1a["Philippine Development Plan<br/>and regional development plans"] --> F1b["Public Investment Program (PIP) and<br/>Three-Year Rolling Infrastructure Program (TRIP),<br/>encoded by agencies in PIPOL"] --> F1c["Appraisal of large projects<br/>by the Investment Coordination<br/>Committee (ICC)"]
  end

  subgraph F2["2  SET THE FISCAL FRAME  -  chapter 02  -  DBCC (DBM, DOF, DEPDev, Office of the President, with BSP)"]
    direction LR
    F2a["Macroeconomic<br/>assumptions"] --> F2b["Revenue program<br/>(BIR, BOC, BTr)"] --> F2c["Spending ceiling<br/>and deficit target"] --> F2d["Borrowing<br/>program"]
  end

  subgraph F3["3  PREPARE THE BUDGET  -  chapter 03  -  agencies, RDCs, DBM, President"]
    direction LR
    F3a["Budget Call<br/>(National Budget<br/>Memorandum)"] --> F3b["Agency proposals:<br/>Tier 1 and Tier 2,<br/>submitted in OSBPS"] --> F3c["DBM technical hearings<br/>and executive review,<br/>DBCC, President and Cabinet"] --> F3d["President's budget:<br/>NEP, BESF,<br/>Budget Message"]
  end

  subgraph F4["4  LEGISLATE  -  chapter 04  -  House of Representatives, Senate, President"]
    direction LR
    F4a["House: General<br/>Appropriations Bill"] --> F4b["Senate"] --> F4c["Bicameral<br/>conference"] --> F4d["President signs,<br/>may veto items"] --> F4e["General Appropriations Act (GAA).<br/>If not passed in time, the<br/>previous GAA is re-enacted"]
  end

  subgraph F5["5  RELEASE AUTHORITY  -  chapter 05  -  DBM, agency central office"]
    direction LR
    F5a["Budget execution documents:<br/>financial plan, physical plan,<br/>monthly disbursement program (URS)"] --> F5b["ALLOTMENT = authority to commit.<br/>GAA as allotment order,<br/>or SARO / GARO (ADRS)"] --> F5c["CASH AUTHORITY = limit for payments.<br/>NCA to the servicing bank,<br/>also NCAA and CDC"]
  end

  subgraph F6["6  COMMIT  -  chapters 06 and 12  -  agency, bidders"]
    direction LR
    F6a["Procurement plan<br/>(PPMP, APP)"] --> F6b["Bidding and award<br/>(BAC, PhilGEPS)"] --> F6c["Contract"] --> F6d["Obligation<br/>(ORS, registry)"]
    F6d ~~~ F6e["Payroll and other<br/>commitments without<br/>procurement"]
  end

  subgraph F7["7  VERIFY AND PAY  -  chapter 07  -  agency, servicing bank, BTr, BSP"]
    direction LR
    F7a["Delivery, inspection,<br/>acceptance"] --> F7b["Disbursement<br/>voucher"] --> F7c["Payment order<br/>(LDDAP-ADA or check)"] --> F7d["Servicing bank<br/>credits the payee"] --> F7e["Settlement from the<br/>Treasury Single Account"]
  end

  subgraph F8["8  RECORD AND REPORT  -  chapters 08 and 13  -  agency budget, accounting and property units"]
    direction LR
    F8a["Budget registries<br/>(allotments, obligations,<br/>disbursements)"] ~~~ F8b["Journal entries<br/>and ledgers"]
    F8b --> F8c["Quarterly budget and financial<br/>accountability reports (URS)"] --> F8d["Annual financial<br/>statements (AFRS)"]
    F8d ~~~ F8e["Asset and<br/>property records"]
  end

  subgraph F9["9  AUDIT AND OVERSEE  -  chapter 09  -  internal audit, COA, Congress, the public"]
    direction LR
    F9a["Internal control and<br/>internal audit"] ~~~ F9b["COA audit of accounts<br/>and transactions"]
    F9b --> F9c["Audit report, suspension,<br/>disallowance, charge"] --> F9d["Legislative oversight<br/>and public scrutiny"]
  end

  subgraph R["MONEY, ALL YEAR  -  chapters 10 and 11"]
    direction TB
    Ra["Taxes and customs duties<br/>(BIR, BOC) paid through banks"]
    Rb["Fees and other<br/>non-tax income"]
    Rc["Borrowing<br/>(BTr, DOF)"]
    Rd["Treasury Single Account<br/>at BSP, managed by BTr"]
    Re["Cash program<br/>and cash forecast"]
    Rf["Debt service"]
    Ra --> Rd
    Rb --> Rd
    Rc --> Rd
    Rd --> Rf
    Rd ~~~ Re
  end

  subgraph X["OTHER PUBLIC BODIES  -  chapters 14 and 15"]
    direction TB
    Xa["Local governments:<br/>National Tax Allotment,<br/>own budget cycle"]
    Xb["Government corporations:<br/>subsidy, equity,<br/>own corporate budgets"]
    Xc["Special accounts, retained<br/>income and trust funds"]
    Xa ~~~ Xb
    Xb ~~~ Xc
  end

  subgraph B["COMMON BASE  -  chapters 16 and 17"]
    direction LR
    Ba["Laws and rules:<br/>Constitution, EO 292 Book VI,<br/>PD 1445, yearly GAA provisions"] ~~~ Bb["UACS: one coding structure<br/>for budget, accounting<br/>and reporting"]
    Bb ~~~ Bc["Information systems, and the<br/>planned integration with<br/>BTMS as the core (IFMIS)"]
  end

  NEXT(["Returns to rows 1, 2 and 3 of LATER fiscal years:<br/>actual figures, audit findings, evaluation results"])

