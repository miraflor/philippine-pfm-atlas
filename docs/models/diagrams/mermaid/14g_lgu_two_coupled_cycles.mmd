flowchart LR
  subgraph LG["LOCAL: autonomous budget process subject to law"]
    PLAN["Local plan / investment priorities"] --> REV["Local revenue projections and transfers estimate"] --> EX["Local executive budget"] --> SANG["Sanggunian appropriation ordinance"] --> IMPL["Local obligation, payment and service delivery"] --> LOCAL["Local books, fiscal reports and COA audit"]
