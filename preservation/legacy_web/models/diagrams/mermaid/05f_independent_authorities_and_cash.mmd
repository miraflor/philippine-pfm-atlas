  VALID --> CLAIM["Entitlement or delivery verified and claim approved"]
  REV["Actual receipts, borrowing and balances"] --> CASHPLAN["BTr / DBM cash planning"] --> CASH{"Applicable cash or disbursement authority valid?"}
  CLAIM --> BANK{"Payment controls and available balance pass?"}
  CASH -->|Yes| BANK
