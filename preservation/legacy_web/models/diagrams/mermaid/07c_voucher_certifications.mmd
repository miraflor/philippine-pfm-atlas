  style R2 fill:#ffffff,stroke:#444444
  style R3 fill:#ffffff,stroke:#444444
  style R4 fill:#ffffff,stroke:#444444
  style R5 fill:#ffffff,stroke:#444444
  style R6 fill:#ffffff,stroke:#444444
