---
title: "17c  Records of budget execution as a data model: fields, own numbers (PK) and quoted numbers (FK)"
---
erDiagram
  %% QUESTION THIS DIAGRAM ANSWERS: if the records of 17b were tables in one database, which fields would each table have, and by which field would two tables be joined?
  %% READING: one box = one kind of record. PK = the record's own number. FK = the number of another record that it quotes. Fields that start with uacs_ are UACS segments. The text in square brackets on each line names the key that makes the link. "[text only]", "[attachment]" and "[documents]" mean that no coded key exists.
  %% USE: this is a reading aid for designing an integrated system. It is NOT the data model of BTMS or of any existing system.
  %% LEFT COLUMN = the contract and the physical work. MIDDLE = legal authority and accounting. RIGHT = cash.
  %% SIMPLIFICATION: a budget line is identified by its full code (all five segments) and the fiscal year. The diagram marks only the program code (uacs_pap) as its key, because the other records quote the program code.
  %% NOT DRAWN: sub-allotment to operating units (same codes as the allotment), tax remittance, retention money.
  %% SOURCES: UACS segments and digits, location rule [JC2017-1]. LDDAP-ADA fields [LDDAP-FORM]. ORS fields [ORS-FORM]. Column "Code (PAP)" in the procurement plan [APP-FORM]. NCA validity [NBC599].
  %% GENERAL KNOWLEDGE, NOT OPENED IN A SOURCE HERE: fields of the voucher, the journal entry voucher and the audit notices (forms of the Government Accounting Manual, Volume II). PhilGEPS, contract, delivery and asset fields are indicative only.

  GAA_LINE {
    code uacs_funding_source "8 digits"
    code uacs_organization "12 digits"
    code uacs_location "9 digits, area of mandate of the operating unit, not the project site"
    code uacs_pap PK "15 digits, program, activity or project"
    code uacs_object "10 digits, at expense class or object level"
    money amount
    text special_provision
  }
  PROCUREMENT_PLAN_ITEM {
    string app_line PK
    code uacs_pap FK "column Code (PAP)"
    text mode_of_procurement
    money estimated_budget
  }
  PROCUREMENT {
    string philgeps_reference_no PK
    string app_line FK
    money approved_budget_for_contract
    text bids_received
  }
  CONTRACT {
    string contract_no PK
    string philgeps_reference_no FK
    string contractor_tin
    money contract_price
    text project_site "text or agency geotag, not a UACS field"
  }
  DELIVERY_ACCEPTANCE {
    string report_no PK "inspection report or statement of work accomplished"
    string contract_no FK
    number percent_accomplished
    text certified_by
    date date_accepted
  }
  PHYSICAL_ASSET {
    string property_no PK
    string contract_no FK "linked by documents, not by a code"
    text location
    code uacs_object "asset account"
  }
  ALLOTMENT {
    string saro_no PK "no document number when the GAA itself is the allotment order"
    code uacs_funding_source
    code uacs_organization
    code uacs_pap FK
    code allotment_class
    money amount
  }
  OBLIGATION {
    string ors_no PK
    code uacs_pap FK
    code uacs_object
    code responsibility_center
    string payee
    text particulars "the contract is named here as text"
    money amount
  }
  DISBURSEMENT_VOUCHER {
    string dv_no PK
    string ors_no FK
    code uacs_pap
    code uacs_object "in the accounting entry"
    string payee_tin
    money amount
    string jev_no FK
    string ada_or_check_no FK
  }
  JOURNAL_ENTRY {
    string jev_no PK
    code fund_cluster
    code uacs_object "Revised Chart of Accounts"
    money debit
    money credit
  }
  AUDIT_FINDING {
    string notice_no PK "audit observation, or notice of suspension, disallowance or charge"
    string dv_no FK "also JEV, check or ADA numbers"
    text persons_liable
    money amount
    text rule_violated
  }
  CASH_AUTHORITY {
    string nca_no PK
    code uacs_funding_source "fund cluster only"
    code uacs_organization
    string mds_sub_account
    money amount_per_month
    date valid_until "end of the quarter for a regular NCA"
  }
  PAYMENT_ORDER {
    string lddap_ada_no PK
    string nca_no FK
    string mds_sub_account
    code fund_cluster
  }
  PAYMENT_ORDER_LINE {
    string lddap_ada_no FK
    string ors_no FK
    code allotment_class_or_object "per UACS"
    string creditor_bank_account
    money gross
    money tax_withheld
    money net
  }
  BANK_TRANSACTION {
    string bank_reference PK
    string lddap_ada_no FK
    string mds_sub_account
    string payee_account
    money amount
    date value_date
  }
  REPORT_ROW {
    code uacs_pap FK
    code allotment_class
    string period
    money appropriation
    money allotment
    money obligation
    money disbursement
  }

  GAA_LINE ||--o{ PROCUREMENT_PLAN_ITEM : "planned as [UACS]"
  PROCUREMENT_PLAN_ITEM ||--o{ PROCUREMENT : "advertised as [plan line]"
  PROCUREMENT ||--o| CONTRACT : "awarded as [PhilGEPS no.]"
  CONTRACT ||--o{ DELIVERY_ACCEPTANCE : "performed in [contract no.]"
  DELIVERY_ACCEPTANCE ||--o| PHYSICAL_ASSET : "recorded as [documents]"
  GAA_LINE ||--o{ ALLOTMENT : "released as [UACS]"
  CONTRACT ||--o{ OBLIGATION : "supports [text only]"
  ALLOTMENT ||--o{ OBLIGATION : "charged by [UACS]"
  DELIVERY_ACCEPTANCE ||--o{ DISBURSEMENT_VOUCHER : "supports [attachment]"
  OBLIGATION ||--o{ DISBURSEMENT_VOUCHER : "claimed by [ORS no.]"
  DISBURSEMENT_VOUCHER ||--|{ JOURNAL_ENTRY : "recorded by [JEV no.]"
  DISBURSEMENT_VOUCHER ||--o{ AUDIT_FINDING : "examined in [DV no.]"
  OBLIGATION ||--o{ PAYMENT_ORDER_LINE : "paid through [ORS no.]"
  CASH_AUTHORITY ||--o{ PAYMENT_ORDER : "drawn by [NCA no.]"
  PAYMENT_ORDER ||--|{ PAYMENT_ORDER_LINE : "contains"
  PAYMENT_ORDER ||--o{ BANK_TRANSACTION : "executed as [LDDAP-ADA no.]"
  GAA_LINE ||--o{ REPORT_ROW : "reported as [UACS]"
