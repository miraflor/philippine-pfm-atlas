flowchart LR
  OLD["UACS version N + effective date"] --> MAP["Approved, versioned mapping"]
  NEW["UACS version N+1 + effective date"] --> MAP
  MAP --> REL{"Relationship"}
  REL --> ONE["1-to-1: lossless translation if meaning unchanged"]
  REL --> MANY["1-to-many or many-to-1: aggregation/splitting assumptions"]
  REL --> NONE["Unmapped / deprecated: manual adjudication"]
  ONE --> QC["Reconcile totals / semantic definitions / source documents"]
  MANY --> QC
  NONE --> QC
  QC --> REPORT["Comparable time-series subject to documented caveats"]
